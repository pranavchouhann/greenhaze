{
  "include": ["client/src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "local-data"],
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "strict": true,
    "ignoreDeprecations": "6.0",
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./client/src/*"] }
  }
}
